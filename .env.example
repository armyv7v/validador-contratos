# Autenticación (NextAuth)
# Generar con: openssl rand -base64 32   o   npx auth secret
NEXTAUTH_SECRET=

# Credenciales del panel administrativo
# AMBAS son obligatorias. Si falta una, el login queda deshabilitado
# (no hay valores por defecto — es intencional).
ADMIN_USERNAME=
ADMIN_PASSWORD=

# URL pública de la app (Vercel la define sola en producción)
NEXTAUTH_URL=
